# Test Dockerfile for dotfiles setup on Debian
# Validates that the Debian init script runs correctly in a clean environment
#
# Usage:
#   docker build -f tests/docker/Dockerfile.test -t dotfiles-test .
#   docker run --rm dotfiles-test

# Pinned by digest for reproducible builds (bookworm-slim multi-arch index).
# Renovate's docker manager keeps the digest current.
FROM debian:bookworm-slim@sha256:96e378d7e6531ac9a15ad505478fcc2e69f371b10f5cdf87857c4b8188404716 AS base

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      curl \
      git \
      sudo \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root test user
RUN useradd -m -s /bin/bash tester \
    && echo "tester ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER tester
WORKDIR /home/tester

# Copy the dotfiles repo
COPY --chown=tester:tester . /home/tester/.dotfiles

# ---------------------------------------------------------------------------
# Stage: test-bats — run Bats unit tests inside the container
# ---------------------------------------------------------------------------
FROM base AS test-bats

RUN sudo apt-get update \
    && sudo apt-get install -y --no-install-recommends bats jq \
    && sudo rm -rf /var/lib/apt/lists/*

RUN cd /home/tester/.dotfiles && bats tests/

# ---------------------------------------------------------------------------
# Stage: test-init — validate init.sh flag parsing (no actual installs)
# ---------------------------------------------------------------------------
FROM base AS test-init

# Help flag should print usage and exit 0
RUN bash /home/tester/.dotfiles/os/debian/init.sh -h

# No flags should exit 1
RUN bash /home/tester/.dotfiles/os/debian/init.sh 2>&1 && exit 1 || true

# ---------------------------------------------------------------------------
# Stage: test-dotfiles — run a dotfiles-only install (-d flag)
# ---------------------------------------------------------------------------
FROM base AS test-dotfiles

RUN sudo apt-get update \
    && sudo apt-get install -y --no-install-recommends zsh jq \
    && sudo rm -rf /var/lib/apt/lists/*

# Run dotfile linking only. init.sh installs oh-my-zsh first (required for
# dotfile linking), from the commit pinned in os/helpers/oh-my-zsh.sh.
RUN bash /home/tester/.dotfiles/os/debian/init.sh -d

# oh-my-zsh comes from init.sh itself (os/helpers/oh-my-zsh.sh), at the commit
# pinned there: the stage exercises that install instead of pre-installing one.
RUN pinned=$(sed -n '/^install_oh_my_zsh()/,/^}/s/.*local commit="\([0-9a-f]\{40\}\)".*/\1/p' /home/tester/.dotfiles/os/helpers/oh-my-zsh.sh) \
    && test -n "$pinned" \
    && test "$(git -C "$HOME/.oh-my-zsh" rev-parse HEAD)" = "$pinned" \
    && test -f "$HOME/.oh-my-zsh/oh-my-zsh.sh" \
    && echo "oh-my-zsh at pinned commit $pinned verified"

# Verify dotfiles were linked
RUN test -f "$HOME/.zshrc" \
    && test -L "$HOME/.gitconfig" \
    && test -L "$HOME/.config/dotfiles/env.sh" \
    && test -L "$HOME/.config/dotfiles/functions.sh" \
    && test -L "$HOME/.claude/settings.json" \
    && test -L "$HOME/.config/git/ignore" \
    && echo "All dotfile checks passed"

# ---------------------------------------------------------------------------
# Stage: test-base — run base profile install (-p base -l)
# ---------------------------------------------------------------------------
FROM base AS test-base

RUN bash /home/tester/.dotfiles/os/debian/init.sh -p base -l

# Verify base packages were installed
RUN command -v docker \
    && command -v ssh \
    && command -v tree \
    && command -v rsync \
    && command -v ansible \
    && command -v terraform \
    && echo "All base lite checks passed"

# ---------------------------------------------------------------------------
# Stage: test-security — run security profile and verify configs
# ---------------------------------------------------------------------------
FROM base AS test-security

# Install packages the security script would install (pre-seed for Docker)
RUN sudo apt-get update \
    && sudo apt-get install -y --no-install-recommends \
      openssh-server \
      ufw \
      fail2ban \
      python3-systemd \
      unattended-upgrades \
      apt-listchanges \
    && sudo rm -rf /var/lib/apt/lists/*

# An admin who can still log in once root login is off: without one, the
# security profile keeps PermitRootLogin prohibit-password (lockout guard).
RUN sudo usermod -aG sudo tester \
    && mkdir -p -m 700 "$HOME/.ssh" \
    && echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDockerTestKeyNotARealKey000000000000000 tester@test" > "$HOME/.ssh/authorized_keys" \
    && chmod 600 "$HOME/.ssh/authorized_keys"

# Source the script and call each config function individually
# (systemctl/sshd-t/ufw calls will fail silently — that's expected in Docker)
RUN export SUDO="sudo" FULL_MODE_SETUP="false" \
    && sudo mkdir -p /etc/ssh/sshd_config.d /etc/sysctl.d \
    && bash -c ' \
      source /home/tester/.dotfiles/os/debian/setup-security.sh \
    ' 2>&1 || true

# Verify SSH hardening config was created with correct settings
RUN sudo test -f /etc/ssh/sshd_config.d/00-hardening.conf \
    && sudo grep -qx "PermitRootLogin no" /etc/ssh/sshd_config.d/00-hardening.conf \
    && sudo grep -q "PasswordAuthentication no" /etc/ssh/sshd_config.d/00-hardening.conf \
    && sudo grep -q "MaxAuthTries 3" /etc/ssh/sshd_config.d/00-hardening.conf \
    && sudo grep -q "X11Forwarding no" /etc/ssh/sshd_config.d/00-hardening.conf \
    && sudo grep -q "AllowTcpForwarding no" /etc/ssh/sshd_config.d/00-hardening.conf \
    && sudo grep -q "ClientAliveInterval 300" /etc/ssh/sshd_config.d/00-hardening.conf \
    && echo "SSH hardening config verified"

# Verify SSH hardening config has restrictive permissions
RUN sudo stat -c '%a' /etc/ssh/sshd_config.d/00-hardening.conf | grep -q '600' \
    && echo "SSH config permissions verified (600)"

# Verify Fail2Ban jail.local was created with correct settings
RUN sudo test -f /etc/fail2ban/jail.local \
    && sudo grep -q "bantime  = 1h" /etc/fail2ban/jail.local \
    && sudo grep -q "maxretry = 3" /etc/fail2ban/jail.local \
    && sudo grep -q "backend  = systemd" /etc/fail2ban/jail.local \
    && sudo grep -q "banaction = ufw" /etc/fail2ban/jail.local \
    && sudo grep -q "\[sshd\]" /etc/fail2ban/jail.local \
    && sudo grep -q "enabled  = true" /etc/fail2ban/jail.local \
    && echo "Fail2Ban jail.local verified"

# Verify unattended-upgrades config
RUN test -f /etc/apt/apt.conf.d/20auto-upgrades \
    && grep -q 'APT::Periodic::Update-Package-Lists "1"' /etc/apt/apt.conf.d/20auto-upgrades \
    && grep -q 'APT::Periodic::Unattended-Upgrade "1"' /etc/apt/apt.conf.d/20auto-upgrades \
    && echo "Auto-upgrades config verified"

RUN test -f /etc/apt/apt.conf.d/52dotfiles-unattended-upgrades \
    && grep -q '^Unattended-Upgrade::Automatic-Reboot "false"' /etc/apt/apt.conf.d/52dotfiles-unattended-upgrades \
    && grep -q '^Unattended-Upgrade::Remove-Unused-Dependencies "true"' /etc/apt/apt.conf.d/52dotfiles-unattended-upgrades \
    && grep -q 'label=Debian-Security' /etc/apt/apt.conf.d/52dotfiles-unattended-upgrades \
    && echo "Unattended-upgrades config verified"

# What apt actually resolves, all files merged: the packaged
# 50unattended-upgrades origins are cleared, only security archives remain.
RUN origins=$(apt-config dump Unattended-Upgrade::Origins-Pattern | grep '^Unattended-Upgrade::Origins-Pattern:: ') \
    && echo "$origins" | grep -q 'label=Debian-Security' \
    && ! echo "$origins" | grep -v -e 'label=Debian-Security' -e 'distro_codename}-security,label=Ubuntu' \
    && echo "Unattended-upgrades effective origins verified"

# Verify sysctl hardening config
RUN test -f /etc/sysctl.d/99-security.conf \
    && grep -q "net.ipv4.ip_forward = 0" /etc/sysctl.d/99-security.conf \
    && grep -q "net.ipv4.tcp_syncookies = 1" /etc/sysctl.d/99-security.conf \
    && grep -q "net.ipv4.conf.all.rp_filter = 1" /etc/sysctl.d/99-security.conf \
    && grep -q "net.ipv4.conf.all.accept_redirects = 0" /etc/sysctl.d/99-security.conf \
    && grep -q "net.ipv4.conf.all.log_martians = 1" /etc/sysctl.d/99-security.conf \
    && echo "Sysctl hardening config verified"

# Verify shared memory entry in fstab
RUN grep -q "/dev/shm" /etc/fstab \
    && grep -q "noexec,nosuid" /etc/fstab \
    && echo "Shared memory fstab entry verified"

# ---------------------------------------------------------------------------
# Stage: test-security-full — the full-mode security steps: CrowdSec from its
# signed apt repository (pinned key fingerprint) and the audit tools.
# ---------------------------------------------------------------------------
FROM base AS test-security-full

# The slim image has no systemd: the crowdsec and bouncer packages call
# systemctl from their post-install scripts (enable, start), and dpkg aborts
# without it. A no-op stand-in lets them install; starting services is not
# what this stage checks, and a real host has systemd. It goes in /usr/bin:
# maintainer scripts may set a PATH without /usr/local/bin, and the image
# has no systemctl there to overwrite.
RUN test ! -e /usr/bin/systemctl \
    && printf '#!/bin/sh\nexit 0\n' | sudo tee /usr/bin/systemctl > /dev/null \
    && sudo chmod 755 /usr/bin/systemctl

# Run the two full-mode functions on their own, with every failure fatal: the
# lite steps need systemd, sshd and netfilter, which a container lacks, and are
# covered by test-security. A key that fails its fingerprint check fails here.
# install_apt_key comes from os/helpers/fetch.sh, which the script sources.
RUN export SUDO="sudo" \
    && sudo apt-get update -qq \
    && bash -euo pipefail -c ' \
      red="" no_color="" SUDO=sudo; \
      source /home/tester/.dotfiles/os/helpers/fetch.sh; \
      eval "$(sed -n "/^install_configure_crowdsec()/,/^}/p" /home/tester/.dotfiles/os/debian/setup-security.sh)"; \
      eval "$(sed -n "/^install_audit_tools()/,/^}/p" /home/tester/.dotfiles/os/debian/setup-security.sh)"; \
      install_configure_crowdsec; \
      install_audit_tools \
    '

# CrowdSec came from its own repository, trusted through the pinned keyring
RUN test "$(stat -c '%a' /etc/apt/keyrings/crowdsec_crowdsec-archive-keyring.gpg)" = 644 \
    && grep -q 'signed-by=/etc/apt/keyrings/crowdsec_crowdsec-archive-keyring.gpg' /etc/apt/sources.list.d/crowdsec_crowdsec.list \
    && apt-cache policy crowdsec | grep -q 'packagecloud.io/crowdsec' \
    && cscli version \
    && dpkg -s crowdsec-firewall-bouncer-iptables > /dev/null \
    && echo "CrowdSec install verified"

# Audit tools
RUN command -v lynis \
    && command -v rkhunter \
    && command -v chkrootkit \
    && sudo test -x /sbin/auditctl \
    && echo "Audit tools verified"

# ---------------------------------------------------------------------------
# Stage: test-kubernetes — os/debian/setup-kubernetes.sh run on its own: first
# a fresh install on the bare image (no gpg, no kubectl), then in full mode
# (kubectl, helm, k9s) on a system that still has kubectl from an end-of-life
# channel: the script must move it to the minor it pins.
# ---------------------------------------------------------------------------
FROM base AS test-kubernetes

# Fresh install: the script installs gnupg itself (init.sh is not there to),
# then kubectl from the pinned minor's repository.
RUN ! command -v gpg && ! command -v kubectl \
    && SUDO=sudo bash /home/tester/.dotfiles/os/debian/setup-kubernetes.sh

RUN pin=$(sed -n 's/^  local version="\(v1\.[0-9]*\)"$/\1/p' /home/tester/.dotfiles/os/debian/setup-kubernetes.sh) \
    && test -n "$pin" \
    && command -v gpg > /dev/null \
    && grep -q "stable:/$pin/" /etc/apt/sources.list.d/kubernetes.list \
    && kubectl version --client | grep -q "Client Version: $pin\." \
    && echo "fresh install of kubectl $pin verified"

# The state of a machine installed before the move: kubectl from the v1.32
# repository, the script's previous pin. Every minor's repository is signed by
# the same key, so the keyring the fresh install wrote serves this one too.
RUN sudo apt-get purge -y -qq kubectl > /dev/null \
    && echo 'deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.32/deb/ /' \
      | sudo tee /etc/apt/sources.list.d/kubernetes.list > /dev/null \
    && sudo apt-get update -qq \
    && sudo apt-get install -y -qq kubectl > /dev/null \
    && kubectl version --client | grep -q 'Client Version: v1\.32\.'

RUN SUDO=sudo FULL_MODE_SETUP=true bash /home/tester/.dotfiles/os/debian/setup-kubernetes.sh

# kubectl now comes from the pinned minor's repository, read from the script
RUN pin=$(sed -n 's/^  local version="\(v1\.[0-9]*\)"$/\1/p' /home/tester/.dotfiles/os/debian/setup-kubernetes.sh) \
    && test -n "$pin" \
    && grep -q "stable:/$pin/" /etc/apt/sources.list.d/kubernetes.list \
    && kubectl version --client | grep -q "Client Version: $pin\." \
    && echo "kubectl moved to $pin verified"

# A second run finds kubectl current and leaves it alone
RUN SUDO=sudo bash /home/tester/.dotfiles/os/debian/setup-kubernetes.sh \
      | grep -q 'already installed from the v1\.[0-9]* repository — skipping' \
    && echo "re-run skip verified"

# Full mode: helm and k9s from their pinned, checksummed releases
RUN command -v helm && helm version --short \
    && command -v k9s && k9s version --short \
    && echo "helm and k9s verified"

# ---------------------------------------------------------------------------
# Stage: test-full — full install with all profiles (-a -l for lite mode)
# ---------------------------------------------------------------------------
FROM base AS test-full

RUN sudo apt-get update \
    && sudo apt-get install -y --no-install-recommends \
      zsh \
      jq \
      openssh-server \
      ufw \
      fail2ban \
      python3-systemd \
      unattended-upgrades \
      apt-listchanges \
    && sudo rm -rf /var/lib/apt/lists/*

# An admin who can still log in once root login is off: without one, the
# security profile keeps PermitRootLogin prohibit-password (lockout guard).
RUN sudo usermod -aG sudo tester \
    && mkdir -p -m 700 "$HOME/.ssh" \
    && echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDockerTestKeyNotARealKey000000000000000 tester@test" > "$HOME/.ssh/authorized_keys" \
    && chmod 600 "$HOME/.ssh/authorized_keys"

# Run full install in lite mode (all profiles enabled, skip heavy tools)
RUN sudo mkdir -p /etc/ssh/sshd_config.d /etc/sysctl.d \
    && bash /home/tester/.dotfiles/os/debian/init.sh -a -l 2>&1 || true

# oh-my-zsh comes from init.sh itself (os/helpers/oh-my-zsh.sh), at the commit
# pinned there: the stage exercises that install instead of pre-installing one.
RUN pinned=$(sed -n '/^install_oh_my_zsh()/,/^}/s/.*local commit="\([0-9a-f]\{40\}\)".*/\1/p' /home/tester/.dotfiles/os/helpers/oh-my-zsh.sh) \
    && test -n "$pinned" \
    && test "$(git -C "$HOME/.oh-my-zsh" rev-parse HEAD)" = "$pinned" \
    && test -f "$HOME/.oh-my-zsh/oh-my-zsh.sh" \
    && echo "oh-my-zsh at pinned commit $pinned verified"

# Verify base profile artifacts
RUN command -v docker \
    && command -v ssh \
    && command -v tree \
    && echo "Base profile verified"

# Verify dotfiles were linked
RUN test -f "$HOME/.zshrc" \
    && test -L "$HOME/.gitconfig" \
    && echo "Dotfiles verified"

# Verify security configs exist
RUN sudo test -f /etc/ssh/sshd_config.d/00-hardening.conf \
    && sudo test -f /etc/fail2ban/jail.local \
    && test -f /etc/sysctl.d/99-security.conf \
    && test -f /etc/apt/apt.conf.d/20auto-upgrades \
    && test -f /etc/apt/apt.conf.d/52dotfiles-unattended-upgrades \
    && echo "Security configs verified"

# ---------------------------------------------------------------------------
# Default stage: run all test stages
# ---------------------------------------------------------------------------
FROM test-bats AS final
