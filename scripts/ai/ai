#!/usr/bin/env bash
set -euo pipefail

# ai — single entry point for the local AI tooling (Ollama over HTTP).
# Each subcommand is its own script, found via $PATH (symlinked into
# ~/.local/bin by the provisioning scripts) — no hardcoded paths.

# shellcheck source=../../config/ai-tools/config.sh
source "${XDG_CONFIG_HOME:-$HOME/.config}/ai-tools/config.sh"

usage() {
  cat <<EOF
ai — local AI tooling (Ollama over HTTP)

Usage: ai <command> [args]

Commands:
  commit             Generate a Conventional Commits message from the staged diff
  explain <file>     Explain what a file does
  ask "<question>"   Ask the model a one-off question
  test-api           Smoke-test an OpenAI-compatible API from the local .env
  models             Show which model is selected, and what Ollama has installed
  help               Show this help

Examples:
  ai commit
  ai explain os/helpers/links.sh
  ai ask "what does set -euo pipefail do?"
  ai test-api --models-only

Configuration (override via environment):
  AI_HOST=$AI_HOST
  AI_MODELS=${AI_MODELS:-<empty: automatic selection>}
  AI_MAX_MODEL_GB=$AI_MAX_MODEL_GB
  AI_NUM_CTX=$AI_NUM_CTX
  AI_TEMPERATURE=$AI_TEMPERATURE
  AI_PRESENCE_PENALTY=$AI_PRESENCE_PENALTY

No model is hardcoded. AI_MODELS is an ordered preference list — set it in the
untracked ~/.config/dotfiles/env.local.sh, e.g.

  export AI_MODELS="qwen3.5:9b qwen2.5-coder:7b"

Left empty, the largest installed model that can generate and fits
AI_MAX_MODEL_GB is used. Reasoning support is read from the model's own
capabilities. \`ai models\` shows the outcome.
EOF
}

cmd="${1:-help}"
[ "$#" -gt 0 ] && shift || true

case "$cmd" in
  commit)    exec git-aicommit "$@" ;;
  explain)   exec ai-explain "$@" ;;
  test-api)  exec ai-test-api "$@" ;;
  ask)
    if [ "$#" -eq 0 ]; then
      printf 'error: ask requires a question\n' >&2
      exit 1
    fi
    ai_run "$*"
    ;;
  models)
    # Selection is otherwise invisible: it happens inside ai_run, at call time.
    if _ai_resolve; then
      printf 'model      %s\n' "$AI_MODEL"
      printf 'fast       %s\n' "$AI_MODEL_FAST"
      printf 'think      %s\n' "${AI_THINK:-<omitted from payload>}"
      printf 'chosen by  %s\n' "$AI_SELECTED_BY"
    fi
    printf '\ninstalled:\n'
    _ai_model_list | while IFS="$(printf '\t')" read -r size name; do
      printf '  %-28s %s GB\n' "$name" "$(( size / 1000000000 ))"
    done
    ;;
  help | -h | --help) usage ;;
  *)
    printf 'error: unknown command: %s\n\n' "$cmd" >&2
    usage >&2
    exit 1
    ;;
esac
