#!/usr/bin/env bash
set -euo pipefail

# git-aicommit — generate a Conventional Commits message from the staged diff
# (via the local AI tooling / Ollama) and optionally create the commit.
# Usable as `git aicommit` once on $PATH.

# shellcheck source=../../config/ai-tools/config.sh
source "${XDG_CONFIG_HOME:-$HOME/.config}/ai-tools/config.sh"

ASSUME_YES=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    -y | --yes) ASSUME_YES=true; shift ;;
    -h | --help)
      printf 'Usage: git-aicommit [-y|--yes]\n'
      printf '  Generate a Conventional Commits message from the staged diff.\n'
      printf '  -y, --yes   commit without the interactive confirmation.\n'
      exit 0
      ;;
    *) printf 'error: unknown argument: %s\n' "$1" >&2; exit 1 ;;
  esac
done

ai_require_deps || exit 1

diff="$(git diff --staged)"
if [ -z "$diff" ]; then
  printf 'error: no staged changes. Stage something with `git add` first.\n' >&2
  exit 1
fi

# Full file list (cheap, never truncated) so the model still sees every touched
# file even when a large diff body gets clipped to AI_MAX_DIFF below — crucial
# for sweeping changesets (dozens of files) where the diff alone would be partial.
stat="$(git diff --staged --stat)"

# Keep the prompt bounded: truncate the diff to AI_MAX_DIFF bytes.
# Pure-bash slicing (no pipe) so a large diff can't SIGPIPE `printf` when
# `head` closes the pipe early — which, under `set -euo pipefail`, aborted the
# whole script silently on any diff larger than AI_MAX_DIFF.
truncated=false
if [ "${#diff}" -gt "$AI_MAX_DIFF" ]; then
  diff="${diff:0:$AI_MAX_DIFF}"
  truncated=true
fi

# generate — build the prompt and return the cleaned commit message on stdout.
generate() {
  local diff_note="" prompt msg
  [ "$truncated" = true ] && diff_note=" (truncated — rely on the file list above for full scope)"

  prompt="$(cat <<EOF
You are a senior engineer writing ONE git commit message in Conventional Commits
format that describes a set of staged changes.

Format (must satisfy release-please's default Conventional Commits parser):
- Header: <type>(<scope>)<!>: <summary>
  - <type> is exactly one of these release-please-recognized types — never invent
    another: feat, fix, perf, deps, revert, docs, style, chore, refactor, test,
    build, ci. Pick it from the dominant intent of the change.
    - feat  → a new feature        (triggers a minor release)
    - fix   → a bug fix            (triggers a patch release)
    - perf  → a performance change (triggers a patch release)
    - deps, revert, docs, style, chore, refactor, test, build, ci → no release;
      use them only when none of feat/fix/perf fits the dominant intent.
  - <scope> is optional: the most relevant module/area touched. Omit it when the
    change spans many unrelated areas.
  - Append '!' before the colon (e.g. 'feat(api)!:') ONLY for a breaking change;
    when you do, the body MUST include a 'BREAKING CHANGE: <what broke>' line.
    This is what release-please reads to cut a major release.
  - <summary> is imperative, present tense, <= 72 characters, no trailing period.
- Body (after one blank line) — REQUIRED whenever the change is non-trivial or
  touches more than one file:
  - Explain WHAT changed and especially WHY, not the literal how.
  - Use concise '- ' bullet points; one concern per bullet; group related edits.
  - Name the affected components/files/areas when it adds clarity.
  - When several concerns are mixed, lead the header with the most significant one
    and cover the rest as bullets.

Output ONLY the raw commit message (header, then optional blank line + body).
No backticks, no code fences, no preamble, no explanation.

Changed files (complete list):
$stat

Staged diff${diff_note}:
$diff
EOF
)"

  msg="$(ai_run "$AI_MODEL" "$prompt")" || return 1
  # Drop any stray Markdown code-fence lines the model may have added.
  printf '%s\n' "$msg" | grep -v '^[[:space:]]*```' || true
}

# show_msg — render the current $msg inside a framed box.
show_msg() {
  printf '\n'
  printf '┌─ Proposed commit message ─────────────────────────────\n'
  printf '%s\n' "$msg" | sed 's/^/│ /'
  printf '└───────────────────────────────────────────────────────\n'
}

# commit_command — the exact `git commit` invocation that reuses $msg verbatim.
commit_command() {
  printf 'git commit -m %s' "$(printf '%q' "$msg")"
}

msg="$(generate)" || exit 1
show_msg

# Run `git commit` with the generated message; if it fails (e.g. a pre-commit
# hook rejected it) print the exact command so the same message can be reused —
# no need to re-run `ai commit` and regenerate a different one.
do_commit() {
  if git commit "$@" -m "$msg"; then
    return 0
  fi
  local status=$?
  printf '\n' >&2
  printf 'Commit failed (pre-commit hook?). To retry with the SAME message:\n\n' >&2
  printf '  %s\n\n' "$(commit_command)" >&2
  printf 'Append --no-verify to skip the hooks.\n' >&2
  exit "$status"
}

if [ "$ASSUME_YES" = true ]; then
  do_commit
  exit $?
fi

# Interactive menu. 'c' prints the ready-to-run command instead of committing,
# so the commit can be executed by hand after a final review.
while true; do
  printf '[y]es commit · [e]dit · [r]egenerate · [c]ommand · [N]o? '
  read -r reply || reply=""
  case "$reply" in
    y | Y) do_commit; exit $? ;;
    e | E) do_commit -e; exit $? ;;
    r | R)
      printf 'Regenerating…\n' >&2
      msg="$(generate)" || exit 1
      show_msg
      ;;
    c | C)
      printf '\nReview, then run this to commit:\n\n'
      printf '  %s\n\n' "$(commit_command)"
      exit 0
      ;;
    *) printf 'Annulé.\n' >&2; exit 1 ;;
  esac
done
