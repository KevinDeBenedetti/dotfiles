#!/usr/bin/env bash
set -euo pipefail

# ollama-setenv — apply the settings from config/ollama/env.sh to the Ollama
# server, using whichever mechanism the current OS actually supports.
#
# Ollama exposes no configuration file for these (the one documented JSON file
# covers only `disable_ollama_cloud`); environment variables are the mechanism,
# and how you set them differs per platform:
#
#   macOS  the app is started by launchd, which never reads a shell rc file.
#          `launchctl setenv` is the supported path — and on its own it is
#          session-scoped, hence the LaunchAgent in config/ollama/launchd/.
#   Linux  the daemon runs under systemd, configured by a drop-in at
#          /etc/systemd/system/ollama.service.d/override.conf. That path needs
#          root, so this script renders the file and prints the command rather
#          than escalating on its own.
#
# env.sh stays the single source of truth for the values in both cases.
#
# The server reads its environment ONCE, at startup — restart it afterwards.

ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/ollama/env.sh"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG="$STATE_DIR/ollama-env.log"

main() {

printf '=== ollama-setenv %s ===\n' "$(date '+%Y-%m-%d %H:%M:%S')"

if [ ! -f "$ENV_FILE" ]; then
  printf 'error: %s not found. Run the dotfiles link step first.\n' "$ENV_FILE" >&2
  return 1
fi

# shellcheck source=../../config/ollama/env.sh
source "$ENV_FILE"

# Derive the variable names from the file rather than keeping a second list:
# a hand-maintained list drifts from the assignments, and a variable silently
# left behind is exactly the failure this script exists to prevent.
#
# Read with a plain loop, not `mapfile`: launchd runs this with a minimal PATH,
# so `/usr/bin/env bash` can resolve to Apple's bash 3.2, which has no mapfile.
#
# Fed by a here-string rather than `< <(…)`: process substitution needs /dev/fd,
# which is not guaranteed in a restricted context.
# `|| true` because grep exits 1 on no match, which under `set -e` would kill the
# script here — silently, before the explicit check below could report why.
names="$(grep -oE '^OLLAMA_[A-Z0-9_]+=' "$ENV_FILE" | tr -d '=' || true)"
vars=()
while IFS= read -r name; do
  [ -n "$name" ] && vars+=("$name")
done <<< "$names"

if [ "${#vars[@]}" -eq 0 ]; then
  printf 'error: no OLLAMA_* assignment found in %s\n' "$ENV_FILE" >&2
  return 1
fi

case "$(uname -s)" in
  Darwin)
    for var in "${vars[@]}"; do
      launchctl setenv "$var" "${!var}"
      printf '  %-28s %s\n' "$var" "${!var}"
    done
    printf '\n%d variable(s) set in the launchd session.\n' "${#vars[@]}"
    printf 'Quit and reopen Ollama.app — the server reads its environment at startup.\n'
    ;;

  Linux)
    override="$STATE_DIR/ollama-override.conf"
    {
      printf '# Generated by ollama-setenv from %s\n' "$ENV_FILE"
      printf '# Do not edit here — edit env.sh and re-run ollama-setenv.\n'
      printf '[Service]\n'
      for var in "${vars[@]}"; do
        printf 'Environment="%s=%s"\n' "$var" "${!var}"
      done
    } > "$override"

    printf '  rendered %d variable(s) to %s\n\n' "${#vars[@]}" "$override"
    sed 's/^/    /' "$override"
    printf '\nInstall it (needs root), then restart the daemon:\n\n'
    printf '  sudo install -Dm644 %s \\\n' "$override"
    printf '    /etc/systemd/system/ollama.service.d/override.conf\n'
    printf '  sudo systemctl daemon-reload && sudo systemctl restart ollama\n'
    ;;

  *)
    printf 'error: unsupported OS: %s\n' "$(uname -s)" >&2
    printf 'Set these variables by hand; see config/ollama/README.md.\n' >&2
    return 1
    ;;
esac

}

# Duplicate output to a log: a LaunchAgent that fails does so silently, and this
# is the only trace left. Per-user under $XDG_STATE_HOME, never /tmp — that
# directory is world-writable and shared between accounts.
#
# A plain pipe rather than `exec > >(tee …)`: process substitution needs /dev/fd,
# which is not available in every sandboxed or restricted context launchd may
# hand us. PIPESTATUS carries main's exit code past tee.
mkdir -p "$STATE_DIR" 2>/dev/null || true
if : >>"$LOG" 2>/dev/null; then
  main 2>&1 | tee -a "$LOG"
  exit "${PIPESTATUS[0]}"
fi

main
