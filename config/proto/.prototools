# Versions are pinned for reproducible toolchains; Renovate bumps them via the
# `.prototools` customManager in renovate.json (npm uses node's bundled version).
# renovate: datasource=npm depName=bun
bun = "1.3.14"
# renovate: datasource=node-version depName=node
node = "26.3.0"
npm = "bundled"
# renovate: datasource=npm depName=pnpm
pnpm = "11.7.0"
python = "3.12.13"
# renovate: datasource=npm depName=yarn
yarn = "1.22.22"
go = "1.26.2"

[tools.node]
bundled-npm = true

[tools.npm]
shared-globals-dir = true

[settings]
auto-install = true
auto-clean = true
pin-latest = "global"
