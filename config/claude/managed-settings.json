{
  "permissions": {
    "deny": [
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh repo delete*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Read(**/*.env)",
      "Edit(**/*.env)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/config)",
      "Read(~/.config/dotfiles/env.local.sh)",
      "Read(~/.config/opencode/llm-api-key)",
      "Edit(~/.config/dotfiles/env.local.sh)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(gh auth token*)",
      "Bash(git credential*)",
      "Bash(rtk git commit)",
      "Bash(rtk git commit *)",
      "Bash(rtk git push)",
      "Bash(rtk git push *)",
      "Bash(rtk gh repo delete*)",
      "Bash(rtk gh auth token*)",
      "Bash(rtk git credential*)"
    ],
    "ask": [
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(kubectl delete*)",
      "Bash(gh pr merge*)",
      "Bash(rtk terraform apply*)",
      "Bash(rtk terraform destroy*)",
      "Bash(rtk kubectl delete*)",
      "Bash(rtk gh pr merge*)"
    ]
  },
  "disableBypassPermissionsMode": "disable",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "kevindb.dev",
        "*.kevindb.dev",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "releases.hashicorp.com",
        "registry.terraform.io",
        "api.hetzner.cloud",
        "localhost",
        "127.0.0.1"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyRead": [
        "**/.env",
        "**/.env.*",
        "**/*.env",
        "~/.ssh/**",
        "~/.kube/config",
        "~/.config/dotfiles/env.local.sh",
        "~/.config/opencode/llm-api-key",
        "~/.aws/**",
        "~/.gnupg/**",
        "~/.netrc",
        "~/.npmrc",
        "~/.claude/.credentials.json",
        "**/*.pem",
        "**/*.key"
      ],
      "allowRead": [
        "~/.ssh/*.pub",
        "~/.ssh/config",
        "~/.ssh/config.d/**",
        "~/.ssh/known_hosts",
        "/**/.env.example"
      ],
      "denyWrite": [
        "**/.env",
        "**/.env.*",
        "**/*.env",
        "~/.ssh/**",
        "~/.aws/**",
        "~/.gnupg/**",
        "~/.claude/.credentials.json",
        "~/.config/dotfiles/env.local.sh"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); if printf '%s' \"$cmd\" | grep -qE '(^|[^[:alnum:]_.-])git([[:space:]]+(-[Cc]|--git-dir|--work-tree|--namespace|--exec-path|--config-env)[[:space:]]+[^[:space:]]+|[[:space:]]+-[^[:space:]]+)*[[:space:]]+(commit|push)([^[:alnum:]_-]|$)'; then echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"git commit/push sont bloqués par la politique managée (managed-settings.json)\"}}'; fi"
          },
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); if printf '%s' \"$cmd\" | grep -qE '(^|[^[:alnum:]_.-])kubectl[[:space:]]([^;&|]*[[:space:]])?get[[:space:]]([^;&|]*[[:space:],])?secrets?([[:space:]/,]|$)'; then echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"la lecture des Secrets Kubernetes est bloquée par la politique managée (managed-settings.json)\"}}'; fi"
          }
        ]
      }
    ]
  }
}
