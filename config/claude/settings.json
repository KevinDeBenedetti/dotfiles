        "**/*.env",
        "~/.ssh/**",
        "~/.aws/**",
        "~/.gnupg/**",
        "~/.claude/.credentials.json",
        "~/.config/dotfiles/env.local.sh",
        "~/.dotfiles/**"
      ],
      "denyRead": [
        "**/.env",
        "**/.env.local",
        "**/.env.production",
        "**/*.env",
        "~/.ssh/**",
        "~/.kube/config",
        "~/.config/dotfiles/env.local.sh",
        "~/.config/opencode/llm-api-key",
        "~/.aws/**",
        "~/.gnupg/**",
        "~/.netrc",
        "~/.npmrc",
        "~/.claude/.credentials.json",
        "**/*.pem",
        "**/*.key"
      ],
      "allowRead": [
        "~/.ssh/*.pub",
        "~/.ssh/config",
        "~/.ssh/config.d/**",
        "~/.ssh/known_hosts",
        "/**/.env.example"
      ]
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
