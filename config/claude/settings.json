        "quay.io",
        "gcr.io",
        "registry-1.docker.io",
        "auth.docker.io",
        "index.docker.io",
        "production.cloudflare.docker.com",
        "localhost",
        "127.0.0.1"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/Library/Application Support/rtk/**",
        "~/dev/infra",
        "~/dev/github-workflows",
        "~/.cache/**",
        "~/Library/Caches/go-build/**",
        "~/go/pkg/mod/**",
        "~/.bun/install/cache/**"
      ],
      "denyWrite": [
        "**/.env",
        "**/.env.local",
