# ~/.ssh/config — managed by dotfiles
# ─────────────────────────────────────────────────────────────────────────────

# Must come before any use of UseKeychain (macOS-only, see Host * below), so
# the same file also works with Linux OpenSSH.
IgnoreUnknown UseKeychain

# Machine/infra-specific hosts (IPs, internal servers, …) live in local,
# UNVERSIONED files. Listed first so their settings take precedence
# (ssh uses the first obtained value for each parameter).
Include ~/.ssh/config.d/*.conf

Host *
  # Do NOT forward local LC_* / LANG variables to remote hosts.
  # macOS sends these by default; remote Debian servers may not have the
  # same locale installed, causing "setlocale: LC_ALL: cannot change locale"
  # warnings on every SSH login.
  SendEnv -LC_* -LANG

  # Reuse existing connections (faster repeat logins)
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 60s

  # Keep connection alive
  ServerAliveInterval 60
  ServerAliveCountMax 3

  # Passphrase. UseKeychain exists only in Apple's OpenSSH: without the
  # IgnoreUnknown above it, ssh on Linux stops with "Bad configuration option".
  UseKeychain yes
  AddKeysToAgent yes
