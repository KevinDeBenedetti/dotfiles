# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Include /Users/kevin/.config/colima/ssh_config

Include /Users/kevin/.colima/ssh_config

# ~/.ssh/config — managed by dotfiles
# ─────────────────────────────────────────────────────────────────────────────

Host *
  # Do NOT forward local LC_* / LANG variables to remote hosts.
  # macOS sends these by default; remote Debian servers may not have the
  # same locale installed, causing "setlocale: LC_ALL: cannot change locale"
  # warnings on every SSH login.
  SendEnv -LC_* -LANG

  # Reuse existing connections (faster repeat logins)
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 60s

  # Keep connection alive
  ServerAliveInterval 60
  ServerAliveCountMax 3

  # Passphrase
  UseKeychain yes
  AddKeysToAgent yes

Host github-pro
    HostName github.com
    User git
    IdentityFile ~/.ssh/github_pro
    IdentitiesOnly yes

Host github-perso
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_rsa
    IdentitiesOnly yes
