{
  // visuals
  "telemetry.telemetryLevel": "off",
  "window.autoDetectColorScheme": true,
  "workbench.colorTheme": "GitHub Dark Default",
  "workbench.fontAliasing": "antialiased",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.editor.showTabs": "multiple",
  "terminal.integrated.fontFamily": "Hack Nerd Font Mono",
  "editor.fontFamily": "Input Mono, Fira Code, monospace",
  "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss06', 'zero'",
  "editor.cursorBlinking": "phase",
  "editor.suggestSelection": "first",
  "editor.wordWrap": "on",
  "editor.bracketPairColorization.enabled": true,
  "editor.tabSize": 2,
  "search.exclude": {
    "**/.git": true,
    "**/.nuxt": true,
    "**/.pnpm": true,
    "**/.vscode": true,
    "**/.yarn": true,
    "**/dist/**": true,
    "**/logs": true,
    "**/node_modules": true,
    "**/out/**": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true,
    "**/yarn.lock": true
  },
  // general
  "files.autoSave": "afterDelay",
  "editor.unicodeHighlight.invisibleCharacters": false,
  "security.workspace.trust.untrustedFiles": "prompt",
  "workbench.startupEditor": "none",
  // python — disable VS Code auto-activating venvs in terminals (direnv handles this)
  "python.terminal.activateEnvironment": false,
  "python-envs.terminal.autoActivationType": "off",
  "python.defaultInterpreterPath": "~/.proto/shims/python",
  // git
  "git.autofetch": true,
  "git.untrackedChanges": "separate",
  // github
  "githubPullRequests.pullBranch": "never",
  // eslint
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "eslint.format.enable": true,
  "eslint.quiet": true,
  "eslint.validate": [
    "javascript",
    "typescript",
    "javascriptreact",
    "typescriptreact",
    "vue",
    "html",
    "markdown",
    "json",
    "jsonc",
    "json5"
  ],
  // stylelint
  "css.validate": false,
  "less.validate": true,
  "scss.validate": true,
  "files.associations": {
    "*.css": "postcss",
  },
  // languages
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "typescript.preferences.quoteStyle": "single",
  "typescript.preferences.importModuleSpecifierEnding": "js",
  "typescript.suggest.completeJSDocs": true,
  "typescript.suggest.jsdoc.generateReturns": true,
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "javascript.preferences.quoteStyle": "single",
  "javascript.preferences.importModuleSpecifierEnding": "js",
  "javascript.suggest.completeJSDocs": true,
  "javascript.suggest.jsdoc.generateReturns": true,
  "[html]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[markdown]": {
    "editor.quickSuggestions": {
      "other": true,
      "comments": true,
      "strings": true
    },
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "[yaml]": {
    "diffEditor.ignoreTrimWhitespace": true,
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  // conventional commits
  "conventionalCommits.showNewVersionNotes": false,
  // kubernetes
  "vs-kubernetes": {
    "vs-kubernetes.crd-code-completion": "enabled"
  },
  "vscode-kubernetes.log-viewer.follow": true,
  "vscode-kubernetes.log-viewer.timestamp": false,
  "vscode-kubernetes.log-viewer.since": -1,
  "vscode-kubernetes.log-viewer.tail": -1,
  "vscode-kubernetes.log-viewer.destination": "Webview",
  "vscode-kubernetes.log-viewer.wrap": true,
  // markdown preview
  "markdown-preview-enhanced.previewTheme": "github-dark.css",
  "markdown-preview-enhanced.codeBlockTheme": "github-dark.css",
  "chat.agent.maxRequests": 100,
  "chat.tools.edits.autoApprove": {
    "**/*": true,
    "**/.vscode/*.json": false,
    "**/.git/**": false,
    "**/{package.json,package-lock.json,server.xml,build.rs,web.config,.gitattributes}": false,
    "**/*.{csproj,fsproj,vbproj}": false,
    // secrets — same list as config/claude/settings.json; hard-denied by
    // ~/.copilot/hooks/agent-guard.sh, kept here so they never auto-apply
    "**/{.env,.env.*,*.env}": false,
    "**/*.{pem,key}": false,
    "~/.ssh/**": false,
    "~/.aws/**": false,
    "~/.gnupg/**": false,
    "~/.kube/**": false,
    "**/.config/dotfiles/env.local.sh": false,
    // dotfiles: live (symlinked) configs/scripts and the agent guardrails
    // themselves — Copilot has no sandbox, never let it rewrite them silently
    "**/config/claude/**": false,
    "**/config/copilot/**": false,
    "**/config/opencode/**": false,
    "**/config/vscode/**": false,
    "**/config/shell/**": false,
    "**/config/ollama/**": false,
    "**/config/ssh/**": false,
    "**/scripts/ai/**": false,
    "**/scripts/ollama/**": false
  },
  "chat.tools.terminal.autoApprove": {
    "cd": true,
    "echo": true,
    "ls": true,
    "pwd": true,
    "cat": true,
    "head": true,
    "tail": true,
    "findstr": true,
    "wc": true,
    "tr": true,
    "cut": true,
    "cmp": true,
    "which": true,
    "basename": true,
    "dirname": true,
    "realpath": true,
    "readlink": true,
    "stat": true,
    "file": true,
    "du": true,
    "df": true,
    "sleep": true,
    "git status": true,
    "git log": true,
    "git show": true,
    "git diff": true,
    // never auto-approved; hard-denied by ~/.copilot/hooks/agent-guard.sh
    "git commit": false,
    "git push": false,
    "Get-ChildItem": true,
    "Get-Content": true,
    "Get-Date": true,
    "Get-Random": true,
    "Get-Location": true,
    "Write-Host": true,
    "Write-Output": true,
    "Split-Path": true,
    "Join-Path": true,
    "Start-Sleep": true,
    "Where-Object": true,
    "/^Select-[a-z0-9]/i": true,
    "/^Measure-[a-z0-9]/i": true,
    "/^Compare-[a-z0-9]/i": true,
    "/^Format-[a-z0-9]/i": true,
    "/^Sort-[a-z0-9]/i": true,
    "column": true,
    "/^column\\b.*-c\\s+[0-9]{4,}/": false,
    "date": true,
    "/^date\\b.*(-s|--set)\\b/": false,
    "find": true,
    "/^find\\b.*-(delete|exec|execdir|fprint|fprintf|fls|ok|okdir)\\b/": false,
    "grep": true,
    "/^grep\\b.*-(f|P)\\b/": false,
    "sort": true,
    "/^sort\\b.*-(o|S)\\b/": false,
    "tree": true,
    "/^tree\\b.*-o\\b/": false,
    "/\\(.+\\)/": {
      "approve": false,
      "matchCommandLine": true
    },
    "/\\{.+\\}/": {
      "approve": false,
      "matchCommandLine": true
    },
    "/`.+`/": {
      "approve": false,
      "matchCommandLine": true
    },
    "rm": false,
    "rmdir": false,
    "del": false,
    "Remove-Item": false,
    "ri": false,
    "rd": false,
    "erase": false,
    "dd": false,
    "kill": false,
    "ps": false,
    "top": false,
    "Stop-Process": false,
    "spps": false,
    "taskkill": false,
    "taskkill.exe": false,
    "curl": false,
    "wget": false,
    "Invoke-RestMethod": false,
    "Invoke-WebRequest": false,
    "irm": false,
    "iwr": false,
    "chmod": false,
    "chown": false,
    "Set-ItemProperty": false,
    "sp": false,
    "Set-Acl": false,
    "jq": false,
    "xargs": false,
    "eval": false,
    "Invoke-Expression": false,
    "iex": false,
    "helm": true,
    "bun": true,
    "timeout": true,
    "pnpm": true,
    // read-only docker only: `docker run -v /:/host` is root on the host
    "docker ps": true,
    "docker images": true,
    "docker logs": true,
    "docker compose ps": true,
    "docker compose logs": true,
    // kubectl is read-only for agents (same verbs as config/claude/settings.json)
    "/^kubectl\\s+(get|describe|logs|top|explain|api-resources|version|kustomize|diff|auth\\s+can-i|config\\s+(get-contexts|current-context))\\b/": true,
    "make": true,
    "diff": true,
    "task": true,
    // not bare `go` (go run) nor `command` (prefixes ANY command, so it would
    // slip past every deny rule above)
    "go build": true,
    "go test": true,
    "go vet": true,
    "go fmt": true,
    "go version": true,
    "command -v": true,
    "actionlint": true
  },
  "chat.tools.global.autoApprove": false,
  // agent hooks: loads ~/.copilot/hooks/agent-guard.json (linked by os/helpers/links.sh)
  "chat.useHooks": true,
  "chat.useAgentsMdFile": true,
  // "Generate commit message" (sparkle button in Source Control): Conventional
  // Commits only. Mirrors config/skills/commit-types — keep both in sync.
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Write the commit message strictly in Conventional Commits format: '<type>(<optional scope>)<optional !>: <summary>'. <type> is exactly one of: feat, fix, perf, deps, revert, docs, style, chore, test, build, ci. Never use 'refactor' (use 'chore' for a refactor with no user-facing effect). Prefer the narrowest true type: fix over feat when repairing behavior. Summary: imperative mood, present tense, lowercase start, no trailing period; the whole header (type, scope and summary) is at most 100 characters. When the change is non-trivial or touches several files, add a body after one blank line explaining what changed and why, as '- ' bullets. For a breaking change add '!' immediately before the colon, plus a 'BREAKING CHANGE: <what broke>' footer (uppercase) when the summary alone does not say what breaks. Output only the message: no code fences, quotes, emojis or preamble."
    }
  ],
  "chat.mcp.autostart": "newAndOutdated",
  // extensions
  "database-client.autoSync": true,
  "docker.extension.enableComposeLanguageServer": false,
  "chat.viewSessions.orientation": "stacked",
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "git.replaceTagsWhenPull": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "git.confirmSync": false,
  "editor.minimap.enabled": false,
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://docs.github.com": {
      "approveRequest": false,
      "approveResponse": true
    },
    "https://github.com": {
      "approveRequest": false,
      "approveResponse": true
    },
    "https://www.google.com/search": {
      "approveRequest": true,
      "approveResponse": false
    },
    "https://docs.rxresu.me": true,
    "https://raw.githubusercontent.com": {
      "approveRequest": false,
      "approveResponse": true
    },
    "https://opencode.ai": {
      "approveRequest": true,
      "approveResponse": false
    }
  },
  "terminal.integrated.enableMultiLinePasteWarning": "auto",
  "claudeCode.preferredLocation": "panel",
  "claudeCode.useTerminal": true,
  "extensions.ignoreRecommendations": true,
  "sonarlint.automaticAnalysis": false,
  "makefile.configureOnOpen": false,
  "claudeCode.hideOnboarding": true
}
