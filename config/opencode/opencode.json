{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "custom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Custom OpenAI-compatible",
      "options": {
        "baseURL": "https://llm.example.com/v1",
        "apiKey": "{file:~/.config/opencode/llm-api-key}"
      },
      "models": {
        "example-model": {
          "name": "Example model"
        }
      }
    }
  },
