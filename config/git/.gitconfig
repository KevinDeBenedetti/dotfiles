[user]
	useConfigOnly = true
[push]
	default = simple
	autoSetupRemote = true
[status]
	showUntrackedFiles = all
[diff]
	wordRegex = .
	tool = meld
[branch]
	autosetuprebase = always
	autoSetupMerge = simple
[color]
	ui = true
[rerere]
	enabled = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[rebase]
	autoStash = true

# SSH signing
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

# HTTPS authentication through Git Credential Manager
[credential]
	helper =
	helper = manager
[credential "https://dev.azure.com"]
	useHttpPath = true

# Existing SSH remotes go over HTTPS (so through GCM)
[url "https://github.com/"]
	insteadOf = git@github.com:

# Machine-specific overrides (not versioned). Keep this section last: git keeps
# the last value it reads, so the local file can override any setting above.
[include]
	path = ~/.gitconfig.local
