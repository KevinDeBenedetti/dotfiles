[user]
	useConfigOnly = true
[push]
	default = simple
[status]
	showUntrackedFiles = all
[diff]
	wordRegex = .
	tool = meld
[branch]
	autosetuprebase = always
[color]
	ui = true
[rerere]
	enabled = true
[init]
	defaultBranch = main
[pull]
	rebase = true

# Signature SSH
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

# Authentification HTTPS via GCM
[credential]
	helper =
	helper = manager
[credential "https://dev.azure.com"]
	useHttpPath = true

# Les remotes SSH existantes passent en HTTPS (donc par GCM)
[url "https://github.com/"]
	insteadOf = git@github.com:

# Overrides propres à la machine (non versionnés)
[include]
	path = ~/.gitconfig.local

# Identité par dossier : en dernier pour écraser le reste
[includeIf "gitdir/i:~/dev/"]
	path = ~/.gitconfig-perso
[includeIf "gitdir/i:~/pro/"]
	path = ~/.gitconfig-pro
